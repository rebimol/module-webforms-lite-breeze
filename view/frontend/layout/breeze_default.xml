                                <item name="load" xsi:type="array">
                                    <item name="onRequire" xsi:type="boolean">true</item>
                                </item>
                            </item>
                        </item>
                    </item>
                    <item name="webforms_date" xsi:type="array">
                        <item name="active" xsi:type="boolean">true</item>
                        <item name="sort_order" xsi:type="number">200</item>
                        <item name="items" xsi:type="array">
                            <item name="MageMe_WebFormsLiteBreeze/js/breeze/datepicker" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/datepicker</item>
                        </item>
                    </item>
                    <item name="webforms_region" xsi:type="array">
                        <item name="active" xsi:type="boolean">true</item>
                        <item name="sort_order" xsi:type="number">220</item>
                        <item name="items" xsi:type="array">
                            <item name="MageMe_WebFormsLite/js/region" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/region</item>
                        </item>
                    </item>
                </argument>
