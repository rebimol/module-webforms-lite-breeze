                        <item name="sort_order" xsi:type="number">100</item>
                        <item name="items" xsi:type="array">
                            <item name="tingle" xsi:type="array">
                                <item name="path" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/tingle</item>
                                <item name="load" xsi:type="array">
                                    <item name="onRequire" xsi:type="boolean">true</item>
                                </item>
                            </item>
                            <item name="MageMe_WebFormsLite/js/inputmask" xsi:type="array">
                                <item name="path" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/inputmask</item>
                                <item name="load" xsi:type="array">
                                    <item name="onRequire" xsi:type="boolean">true</item>
                                </item>
                            </item>
                            <item name="MageMe_WebFormsLite/js/prefill" xsi:type="array">
                                <item name="path" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/prefill</item>
                                <item name="load" xsi:type="array">
                                    <item name="onRequire" xsi:type="boolean">true</item>
                                </item>
                            </item>
                            <item name="MageMe_WebFormsLite/js/submit" xsi:type="array">
                                <item name="path" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/submit</item>
                                <item name="load" xsi:type="array">
                                    <item name="onRequire" xsi:type="boolean">true</item>
                                </item>
                            </item>
                            <item name="MageMe_WebFormsLite/js/form" xsi:type="array">
                                <item name="path" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/form</item>
                                <item name="load" xsi:type="array">
                                    <item name="onRequire" xsi:type="boolean">true</item>
                                </item>
                            </item>
                            <item name="swal" xsi:type="array">
                                <item name="path" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/sweetalert2</item>
                                <item name="load" xsi:type="array">
                                    <item name="onRequire" xsi:type="boolean">true</item>
                                </item>
                            </item>
                        </item>
                    </item>
                    <item name="webforms_popup" xsi:type="array">
                        <item name="active" xsi:type="boolean">true</item>
                        <item name="sort_order" xsi:type="number">120</item>
                        <item name="items" xsi:type="array">
                            <item name="MageMe_WebFormsLite/js/popup" xsi:type="array">
                                <item name="path" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/popup</item>
                                <item name="load" xsi:type="array">
                                    <item name="onRequire" xsi:type="boolean">true</item>
                                </item>
                            </item>
                        </item>
                    </item>
                    <item name="webforms_phone" xsi:type="array">
                        <item name="active" xsi:type="boolean">true</item>
                        <item name="sort_order" xsi:type="number">130</item>
                        <item name="items" xsi:type="array">
                            <item name="phoneInput" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/phone/intlTelInput</item>
                            <item name="phoneUtils" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/phone/utils</item>
