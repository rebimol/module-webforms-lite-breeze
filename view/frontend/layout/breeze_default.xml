                        </item>
                    </item>
                    <item name="webforms_dob" xsi:type="array">
                        <item name="active" xsi:type="boolean">true</item>
                        <item name="sort_order" xsi:type="number">170</item>
                        <item name="items" xsi:type="array">
                            <item name="MageMe_WebFormsLite/js/dob" xsi:type="array">
                                <item name="path" xsi:type="string">MageMe_WebFormsLiteBreeze/js/breeze/dob</item>
